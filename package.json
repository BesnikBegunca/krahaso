{
  "name": "krahaso",
  "productName": "Krahaso",
  "version": "1.1.0",
  "description": "Krahaso çmimet nëpër dyqanet online në Kosovë dhe merr rekomandime — desktop dhe web.",
  "main": "src/main.js",
  "author": "Besnik Begunca",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --x64",
    "web": "electron . --web"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.krahaso.app",
    "productName": "Krahaso",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Krahaso"
    },
    "portable": {
      "artifactName": "Krahaso-portable.exe"
    }
  }
}
